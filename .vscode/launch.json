    "version": "0.2.0",
    "configurations": [

        {
            "name": "Launch Server (Go)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/Server"
        },
        {
            "name": "Launch Client (Python)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/clients/main.py",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Run Server and Client",
            "configurations": [
                "Launch Server (Go)",
                "Launch Client (Python)"
            ]
        }
    ]
}